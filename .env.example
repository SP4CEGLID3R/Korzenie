# ─────────────────────────────────────────────────────────────────────────────
# Skopiuj ten plik jako `.env` i uzupełnij wartości (instrukcja w README.md).
# Plik `.env` jest w .gitignore – nigdy go nie commituj.
# ─────────────────────────────────────────────────────────────────────────────

# Adres aplikacji (lokalnie http://localhost:3000, na produkcji Twoja domena).
# Używany w linkach w mailach (potwierdzenie konta, link logowania).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (logowanie) ─────────────────────────────────────────────────────
# Supabase → Project Settings → API Keys.
# Klucz „publishable” jest jawny (trafia do przeglądarki) – to nie jest sekret.
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Baza danych (Prisma) ─────────────────────────────────────────────────────
# Supabase → przycisk „Connect” → zakładka „ORM” / „Connection string”.
# DATABASE_URL – „Transaction pooler” (port 6543), używa go aplikacja:
DATABASE_URL="postgresql://postgres.TWOJ-PROJEKT:HASLO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL – „Session pooler” (port 5432), używa go Prisma do migracji:
DIRECT_URL="postgresql://postgres.TWOJ-PROJEKT:HASLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Claude API (faza 4) ──────────────────────────────────────────────────────
# console.anthropic.com → API Keys. Tylko po stronie serwera!
ANTHROPIC_API_KEY=

# ── Źródła danych (fazy 2–3) ─────────────────────────────────────────────────
# Adres kontaktowy podawany w nagłówku User-Agent przy zapytaniach do Wikidata
# (a później Geneteki). Wikimedia wymaga, żeby automat się przedstawiał – z adresem
# kontaktowym dostajemy wyższy limit zapytań. Może być osobny adres, np. kontakt@domena.
APP_CONTACT_EMAIL=
# Automatyczne pobieranie wyników z Geneteki. Domyślnie WYŁĄCZONE – aplikacja daje
# wtedy gotowe linki, które użytkownik otwiera sam.
# Nie włączaj na produkcji bez zgody Polskiego Towarzystwa Genealogicznego.
# Po włączeniu (true) obowiązuje limit z robots.txt Geneteki: 1 zapytanie na 120 s.
GENETEKA_FETCH_ENABLED=false
